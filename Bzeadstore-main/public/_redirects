# Cloudflare Pages redirect rules for BZEAD
# Static files are served automatically; these rules only run when a file is not found.

# Social preview image — resized JPEG for WhatsApp/Facebook og:image (all products)
/og-image/*  https://aiiefgjfftmerayihpbv.supabase.co/functions/v1/product-og-image?slug=:splat  200
/og-image/*/  https://aiiefgjfftmerayihpbv.supabase.co/functions/v1/product-og-image?slug=:splat  200

# Pre-built share pages — OG meta tags for WhatsApp / Facebook / Twitter (generated at build)
/share/*  /share/:splat/index.html  200
/share/*/  /share/:splat/index.html  200

# Product pages — SSR mode: injects OG meta into SPA shell
/products/*  https://aiiefgjfftmerayihpbv.supabase.co/functions/v1/product-og?slug=:splat&mode=ssr  200
/products/*/  https://aiiefgjfftmerayihpbv.supabase.co/functions/v1/product-og?slug=:splat&mode=ssr  200

# Well-known files must be served as-is (Android App Links, etc.)
/.well-known/*  /.well-known/:splat  200

# SPA fallback — all non-static routes serve index.html
/*  /index.html  200
